# =============================================================================
# 한국투자 Open API 기반 미국주식 초단타 스캘핑 자동매매 시스템
# 환경 변수 설정 파일 (예시)
# =============================================================================

# ===== 한국투자증권 Open API 설정 =====
# 실전투자용 앱키 (계좌에서 실제 거래)
KIS_APP_KEY=your_production_app_key_here
KIS_APP_SECRET=your_production_app_secret_here

# 모의투자용 앱키 (테스트용)
KIS_PAPER_APP_KEY=your_paper_app_key_here
KIS_PAPER_APP_SECRET=your_paper_app_secret_here

# 계좌 정보
KIS_ACCOUNT_NO=12345678
KIS_PRODUCT_CODE=01
KIS_IS_PAPER_TRADING=true

# API 서버 설정
KIS_PROD_URL=https://openapi.koreainvestment.com:9443
KIS_VPS_URL=https://openapivts.koreainvestment.com:29443

# ===== OpenAI API 설정 =====
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.3

# ===== 텔레그램 알림 설정 =====
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=987654321
TELEGRAM_ENABLED=true

# ===== 거래 전략 설정 =====
# 스캘핑 기본 설정
MAX_POSITIONS=5
MAX_POSITION_SIZE=10000
PROFIT_TARGET=0.005
STOP_LOSS=0.003
MAX_HOLDING_TIME=300

# 스크리닝 조건
MIN_VOLUME=1000000
MIN_PRICE=0.01
MAX_PRICE=30.00
GAP_THRESHOLD=0.03
VOLUME_SPIKE=2.0

# ===== 리스크 관리 설정 =====
# 일반 리스크 관리
MAX_DAILY_LOSS=1000
MAX_TOTAL_EXPOSURE=50000
MAX_DRAWDOWN=0.05

# 고도화된 리스크 관리
RISK_MIN_ALLOCATION_MULTIPLIER=0.2
RISK_MAX_ALLOCATION_MULTIPLIER=2.0
RISK_REBALANCE_THRESHOLD=0.05
RISK_CONSECUTIVE_LOSS_LIMIT=5

# ===== 서킷 브레이커 설정 =====
# VIX 임계값
CB_VIX_SPIKE_THRESHOLD=30.0
CB_VIX_CRITICAL_THRESHOLD=50.0

# 시장 변동성 임계값
CB_MARKET_CRASH_THRESHOLD=-0.05
CB_EXTREME_VOLATILITY_THRESHOLD=0.25

# 시스템 성능 임계값
CB_API_DELAY_THRESHOLD=5.0
CB_NETWORK_TIMEOUT_THRESHOLD=10.0
CB_ERROR_RATE_THRESHOLD=0.3

# 서킷 브레이커 활성화
CB_ENABLED=true
CB_AUTO_RECOVERY=false

# ===== MFE/MAE 분석 설정 =====
# 성과 분석 기간
PERFORMANCE_ANALYSIS_WINDOW=30
PERFORMANCE_MIN_TRADES_FOR_ANALYSIS=10

# 구조적 문제 임계값
PERF_PREMATURE_EXIT_THRESHOLD=0.5
PERF_LATE_EXIT_THRESHOLD=0.8
PERF_LOW_EFFICIENCY_THRESHOLD=0.3

# ===== 시장 세션 설정 =====
# 24시간 거래 지원
TRADING_SESSIONS_ENABLED=true
PREMARKET_ENABLED=true
AFTERMARKET_ENABLED=true

# 거래 시간 (한국 시간 기준)
# 썸머타임 (3월~11월)
SUMMER_PREMARKET_START=17:00
SUMMER_PREMARKET_END=22:30
SUMMER_REGULAR_START=22:30
SUMMER_REGULAR_END=05:00
SUMMER_AFTER_START=05:00
SUMMER_AFTER_END=09:00

# 표준시 (11월~3월)
STANDARD_PREMARKET_START=18:00
STANDARD_PREMARKET_END=23:30
STANDARD_REGULAR_START=23:30
STANDARD_REGULAR_END=06:00
STANDARD_AFTER_START=06:00
STANDARD_AFTER_END=10:00

# ===== 데이터 저장 설정 =====
# 로그 설정
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# 데이터 경로
DATA_PATH=data/
LOG_PATH=logs/
BACKUP_PATH=backup/

# ===== 모니터링 설정 =====
# 알림 주기
TELEGRAM_TRADE_ALERTS=true
TELEGRAM_POSITION_UPDATES_INTERVAL=30
TELEGRAM_DAILY_REPORT=true
TELEGRAM_SYSTEM_ALERTS=true

# 성과 리포트 주기
PERFORMANCE_REPORT_INTERVAL=24
RISK_REPORT_INTERVAL=6
CIRCUIT_BREAKER_REPORT_INTERVAL=1

# ===== 백테스트 설정 =====
# 백테스트 기본 설정
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_COMMISSION=0.001

# ===== 디버그 및 개발 설정 =====
# 개발 모드
DEBUG_MODE=false
VERBOSE_LOGGING=false
SAVE_DETAILED_LOGS=true

# 테스트 설정
RUN_UNIT_TESTS=false
RUN_INTEGRATION_TESTS=false
MOCK_API_CALLS=false

# ===== 보안 설정 =====
# API 보안
API_RATE_LIMIT=10
API_RETRY_ATTEMPTS=3
API_TIMEOUT=30

# 데이터 암호화
ENCRYPT_SENSITIVE_DATA=true
ENCRYPTION_KEY=your_encryption_key_here

# ===== 시스템 리소스 설정 =====
# 메모리 및 CPU
MAX_MEMORY_USAGE=2048
MAX_CPU_USAGE=80
THREAD_POOL_SIZE=10

# 캐시 설정
ENABLE_CACHING=true
CACHE_TTL=300
MAX_CACHE_SIZE=1000

# ===== 외부 서비스 설정 =====
# 뉴스 API (옵션)
NEWS_API_KEY=your_news_api_key_here
NEWS_API_ENABLED=false

# 이메일 알림 (옵션)
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# ===== 사용법 =====
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. 실제 값으로 변경 (특히 API 키들)
# 3. 민감한 정보는 절대 git에 커밋하지 마세요
# 4. 정기적으로 API 키를 갱신하세요

# ===== 주의사항 =====
# - 모든 민감한 정보는 안전하게 보관하세요
# - 실전 거래 전 반드시 모의투자로 테스트하세요
# - 시스템 성능을 지속적으로 모니터링하세요
# - 리스크 관리 설정을 신중하게 조정하세요