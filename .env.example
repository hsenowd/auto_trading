# =============================================================================
# 미국 주식 초단타 스캘핑 자동매매 시스템 환경 변수 설정
# =============================================================================

# Alpaca Trading API 설정
# https://alpaca.markets/에서 API 키 발급 받으세요
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# OpenAI GPT API 설정
# https://platform.openai.com/에서 API 키 발급 받으세요
OPENAI_API_KEY=your_openai_api_key_here

# 슬랙 알림 설정 (선택사항)
# https://api.slack.com/messaging/webhooks에서 웹훅 URL 생성
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# 사용 방법:
# 한국투자 Open API 설정
# ===========================================

# 한국투자 Open API 설정
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=your_account_number_here

# 모의투자 여부 (True: 모의투자, False: 실전투자)
KIS_IS_PAPER_TRADING=True

# OpenAI API 설정
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 텔레그램 알림 설정
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# 페이퍼 트레이딩 시뮬레이터 설정
PAPER_TRADING_INITIAL_CASH=50000
PAPER_TRADING_COMMISSION_RATE=0.00025
PAPER_TRADING_SLIPPAGE_RATE=0.0002

# 단계별 배포 설정
DEPLOYMENT_STAGE=paper_testing
FORCE_PAPER_MODE=True

# 하이브리드 검증 설정
ENABLE_PAPER_SIMULATION=True
ENABLE_KIS_PAPER_API=True
ENABLE_REAL_API_TEST=False
ENABLE_HISTORICAL_BACKTEST=True

# 로그 설정
LOG_LEVEL=INFO
LOG_FILE=logs/scalping_system.log

# 거래 시간 설정 (한국 시간 기준)
TRADING_START_TIME=17:00  # 썸머타임 프리마켓 시작
TRADING_END_TIME=09:00    # 썸머타임 애프터마켓 종료

# 리스크 관리 설정
MAX_DAILY_LOSS=1000
MAX_POSITION_SIZE=10000
MAX_POSITIONS=5
CIRCUIT_BREAKER_THRESHOLD=500

# 스캘핑 전략 설정
TARGET_PROFIT_PERCENT=0.5
STOP_LOSS_PERCENT=0.3
MAX_HOLDING_TIME_MINUTES=5
MIN_PRICE_RANGE=0.01
MAX_PRICE_RANGE=30.00

# 급등주 스크리닝 설정
GAP_UP_THRESHOLD=3.0
VOLUME_SURGE_THRESHOLD=2.0
MIN_VOLUME_THRESHOLD=100000
PRICE_CHANGE_THRESHOLD=2.0

# 참고사항:
# 1. 한국투자증권 홈페이지에서 Open API 신청 후 앱키를 발급받으세요
# 2. 실전투자와 모의투자 앱키가 각각 다릅니다
# 3. 계좌번호는 앞 8자리만 입력하세요 (예: 12345678)
# 4. 계좌상품코드: 01(주식), 03(선물옵션)
# 5. OpenAI API 키는 https://platform.openai.com/api-keys 에서 발급받으세요